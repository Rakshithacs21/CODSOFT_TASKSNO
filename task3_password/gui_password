import customtkinter as ctk
import random
import string
import pyperclip

# ---------------- Appearance ----------------
ctk.set_appearance_mode("dark")
ctk.set_default_color_theme("blue")

app = ctk.CTk()
app.title("Password Generator")
app.geometry("500x550")
app.resizable(False, False)

# ---------------- Functions ----------------

def generate_password():
    length = int(length_slider.get())
    strength = strength_var.get()

    if strength == "Weak":
        chars = string.ascii_letters
    elif strength == "Medium":
        chars = string.ascii_letters + string.digits
    else:
        chars = string.ascii_letters + string.digits + string.punctuation

    password = "".join(random.choice(chars) for _ in range(length))

    password_entry.configure(state="normal")
    password_entry.delete(0, "end")
    password_entry.insert(0, password)

    if not show_var.get():
        password_entry.configure(show="*")
    else:
        password_entry.configure(show="")

    password_entry.configure(state="readonly")


def copy_password():
    password = password_entry.get()
    if password:
        pyperclip.copy(password)
        status_label.configure(text="✅ Password Copied!", text_color="lightgreen")


def save_password():
    password = password_entry.get()
    if password:
        with open("saved_passwords.txt", "a") as file:
            file.write(password + "\n")
        status_label.configure(text="💾 Password Saved!", text_color="skyblue")


def toggle_show():
    if show_var.get():
        password_entry.configure(show="")
    else:
        password_entry.configure(show="*")


def update_length(value):
    length_label.configure(text=f"Length : {int(float(value))}")


# ---------------- Title ----------------

title = ctk.CTkLabel(
    app,
    text="🔐 Password Generator",
    font=("Arial", 28, "bold")
)
title.pack(pady=20)

# ---------------- Slider ----------------

length_label = ctk.CTkLabel(app, text="Length : 12", font=("Arial", 16))
length_label.pack()

length_slider = ctk.CTkSlider(
    app,
    from_=6,
    to=30,
    number_of_steps=24,
    command=update_length
)
length_slider.set(12)
length_slider.pack(pady=10)

# ---------------- Strength ----------------

strength_var = ctk.StringVar(value="Strong")

ctk.CTkLabel(app, text="Password Strength", font=("Arial", 18)).pack(pady=10)

ctk.CTkRadioButton(app, text="Weak", variable=strength_var, value="Weak").pack()
ctk.CTkRadioButton(app, text="Medium", variable=strength_var, value="Medium").pack()
ctk.CTkRadioButton(app, text="Strong", variable=strength_var, value="Strong").pack()

# ---------------- Generate ----------------

generate_btn = ctk.CTkButton(
    app,
    text="Generate Password",
    height=45,
    command=generate_password
)
generate_btn.pack(pady=20)

# ---------------- Password Entry ----------------

password_entry = ctk.CTkEntry(
    app,
    width=350,
    height=45,
    font=("Consolas", 18),
    justify="center",
    state="readonly"
)
password_entry.pack()

# ---------------- Show Password ----------------

show_var = ctk.BooleanVar()

show_checkbox = ctk.CTkCheckBox(
    app,
    text="Show Password",
    variable=show_var,
    command=toggle_show
)
show_checkbox.pack(pady=10)

# ---------------- Buttons ----------------

button_frame = ctk.CTkFrame(app, fg_color="transparent")
button_frame.pack(pady=10)

copy_btn = ctk.CTkButton(
    button_frame,
    text="📋 Copy",
    width=120,
    command=copy_password
)
copy_btn.grid(row=0, column=0, padx=10)

save_btn = ctk.CTkButton(
    button_frame,
    text="💾 Save",
    width=120,
    command=save_password
)
save_btn.grid(row=0, column=1, padx=10)

exit_btn = ctk.CTkButton(
    button_frame,
    text="❌ Exit",
    width=120,
    fg_color="red",
    hover_color="darkred",
    command=app.destroy
)
exit_btn.grid(row=0, column=2, padx=10)

# ---------------- Status ----------------

status_label = ctk.CTkLabel(app, text="", font=("Arial", 14))
status_label.pack(pady=15)

app.mainloop()